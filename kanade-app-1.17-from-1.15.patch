+@Composable
+private fun RwSlide(kind: Int, s: RwStats) {
+    when (kind) {
+        RW_EMPTY -> RwLayout(stringResource(R.string.rw_title)) {
+            ReelsBrainFace(0, Modifier.size(180.dp))
